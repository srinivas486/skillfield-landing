{
  "name": "@skillfield/field",
  "version": "1.0.0",
  "description": "Field - AI Sales Agent for Skillfield",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "sales",
    " qualification",
    " langgraph",
    " skillfield"
  ],
  "author": "Skillfield",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "@langchain/langgraph": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}